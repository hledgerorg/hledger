# * import
# ** 1. import applies the receiving journal's commodity styles to imported amounts
$ hledger -f a.j import --dry-run a.csv
2020-01-01
    expenses:unknown                       1.000.000,00
    income:unknown                        -1.000.000,00

>2
would import 1 new transactions from a.csv:

>=

# ** 2. --layout=hledger1 affects the dry-run output (and non-dry-run entries).
$ hledger -f a.j import --dry-run --layout=hledger1 a.csv
2020-01-01
    expenses:unknown     1.000.000,00
    income:unknown      -1.000.000,00

>2
would import 1 new transactions from a.csv:

>=

# ** 3. A dry run archives nothing and leaves the source data file in place,
# including when the dry-run flag is abbreviated (eg --dr).
$ d=$(mktemp -d); mkdir -p $d/rules $d/data; printf '2020-01-01 x\n  (a)  1\n' >$d/main.journal; printf 'source foo*.csv\narchive\nskip 1\nfields date,description,amount\naccount1 a\naccount2 b\n' >$d/rules/foo.rules; printf 'date,description,amount\n2020-01-02,x,1\n' >$d/data/foo.csv; hledger -f $d/main.journal imp --dr >/dev/null 2>&1; ls $d/data; rm -rf $d
foo.csv

# ** 4. A real import archives the data and removes the source data file.
$ d=$(mktemp -d); mkdir -p $d/rules $d/data; printf '2020-01-01 x\n  (a)  1\n' >$d/main.journal; printf 'source foo*.csv\narchive\nskip 1\nfields date,description,amount\naccount1 a\naccount2 b\n' >$d/rules/foo.rules; printf 'date,description,amount\n2020-01-02,x,1\n' >$d/data/foo.csv; hledger -f $d/main.journal import >/dev/null 2>&1; ls $d/data; rm -rf $d
archive

# ** 5. A dry run runs a data generating command, needed to preview the data.
$ d=$(mktemp -d); mkdir -p $d/rules; touch $d/main.journal; printf 'source | touch ran && echo 2020-01-02,1\nfields date,amount\naccount1 a\n' >$d/rules/gen.rules; hledger -f $d/main.journal import --dry-run 2>&1 >/dev/null; ls $d/rules; rm -rf $d
gen.rules: running source command: touch ran && echo 2020-01-02,1
would import 1 new transactions from gen.rules:

gen.rules
ran

# ** 6. A real import runs the data generating command.
$ d=$(mktemp -d); mkdir -p $d/rules; touch $d/main.journal; printf 'source | touch ran && echo 2020-01-02,1\nfields date,amount\naccount1 a\n' >$d/rules/gen.rules; hledger -f $d/main.journal import 2>&1 >/dev/null | sed 's/ to .*//'; ls $d/rules; rm -rf $d
gen.rules: running source command: touch ran && echo 2020-01-02,1
imported 1 new transactions from gen.rules
gen.rules
ran

# ** 7. A dry run still runs a data cleaning command, needed to preview the data.
$ d=$(mktemp -d); mkdir -p $d/rules $d/data; touch $d/main.journal; printf 'source foo.csv | tail -n +2\nfields date,amount\naccount1 a\n' >$d/rules/clean.rules; printf 'date,amount\n2020-01-02,1\n' >$d/data/foo.csv; hledger -f $d/main.journal import --dry-run 2>&1 >/dev/null; rm -rf $d
clean.rules: running source command: tail -n +2
would import 1 new transactions from clean.rules:

>=

# ** 8. A data generating command gets an empty stdin, not hledger's.
$ d=$(mktemp -d); printf 'source | cat\nfields date,amount\naccount1 a\n' >$d/gen.rules; echo 2020-01-02,1 | hledger -f $d/gen.rules print 2>&1; rm -rf $d
gen.rules: running source command: cat
