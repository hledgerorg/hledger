12/11/2019;Foo;123;10.23
RULES
fields date, description, , amount
date-format %d/%m/%Y
$  ./ssvtest.sh
2019-11-12 Foo
    expenses:unknown                              10.23
    income:unknown                               -10.23

>=

# ** 62. tabular rules with comments
<
10/2009/09,Flubber Co,50
10/2009/09,Blubber Co,150

RULES
fields date, description, amount
date-format %d/%Y/%m
currency $
account1 assets:myacct
if|account2|comment
; This rule is for Flubber
%description Flubber|acct|
; This rule is not for Flubber
%amount 150|acct2|cmt2  
; commented out: %description Flubber|acct3|
$  ./csvtest.sh
2009-09-10 Flubber Co
    assets:myacct                                $50
    acct                                        $-50

2009-09-10 Blubber Co  ; cmt2
    assets:myacct                               $150
    acct2                                      $-150

>=0

# ** 63. Single ampersands within a matcher are part of the regexp, not an AND operator. (#2352)
<
2025-01-01,STOP & SHOP,100

RULES
fields date,description,amount

if
%description STOP & SHOP
    account1 expenses:food

$  ./csvtest.sh
2025-01-01 STOP & SHOP
    expenses:food                                100
    income:unknown                              -100

>=

# ** 64. When a directive is declared more than once, the last declaration wins. (#2539)
<
2000-01-01,withdraw,1.00
RULES
fields date,description,amount
date-format %m/%d/%Y
date-format %Y-%m-%d
$  ./csvtest.sh
2000-01-01 withdraw
    expenses:unknown                               1.00
    income:unknown                                -1.00

>=

# ** 65. Except for the skip directive, where the first declaration wins. (#2539)
<
junk line
2000-01-01,withdraw,1.00
RULES
fields date,description,amount
skip 1
skip 2
$  ./csvtest.sh
2000-01-01 withdraw
    expenses:unknown                               1.00
    income:unknown                                -1.00

>=

# ** 66. A directive after an include overrides the included file's directive. (#2539)
$ mkdir -p t2539.$$ && cd t2539.$$ && printf '2000-01-01,withdraw,1.00\n' >t.csv && printf 'fields date,description,amount\ndate-format %%m/%%d/%%Y\n' >common.rules && printf 'include common.rules\ndate-format %%Y-%%m-%%d\n' >t.rules && hledger -f csv:t.csv --rules t.rules print; s=$?; cd ..; rm -rf t2539.$$; exit $s
2000-01-01 withdraw
    expenses:unknown                               1.00
    income:unknown                                -1.00

>=

# ** 67. An error in an included rules file is reported at the right file and line. (#2537)
$ mkdir -p t2537.$$ && cd t2537.$$ && printf '2000-01-01,withdraw,1.00\n' >t.csv && printf 'fields date,description,amount\nbadline\n' >common.rules && printf '# a comment\ninclude common.rules\n' >t.rules && hledger -f csv:t.csv --rules t.rules print; s=$?; cd ..; rm -rf t2537.$$; exit $s
>2 /common\.rules:2:1/
>=1

# ** 68. An error in the top rules file below an include directive is reported at the right line. (#2537)
$ mkdir -p t2537.$$ && cd t2537.$$ && printf '2000-01-01,withdraw,1.00\n' >t.csv && printf 'fields date,description,amount\n# a comment\n' >common.rules && printf 'include common.rules\n# a comment\nbadline\n' >t.rules && hledger -f csv:t.csv --rules t.rules print; s=$?; cd ..; rm -rf t2537.$$; exit $s
>2 /t\.rules:3:1/
>=1

# ** 69. Including a missing rules file gives a helpful error, at the right location.
$ mkdir -p t2537.$$ && cd t2537.$$ && printf '2000-01-01,withdraw,1.00\n' >t.csv && printf 'fields date,description,amount\ninclude nosuch.rules\n' >t.rules && hledger -f csv:t.csv --rules t.rules print; s=$?; cd ..; rm -rf t2537.$$; exit $s
>2 /t\.rules:2:1:
  \|
2 \| include nosuch\.rules
  \| \^
Could not read this included file:/
>=1

# ** 70. Rules files whose include directives form a cycle give a helpful error, at the right location.
$ mkdir -p t2537.$$ && cd t2537.$$ && printf '2000-01-01,withdraw,1.00\n' >t.csv && printf 'include b.rules\n' >a.rules && printf '# a comment\ninclude a.rules\n' >b.rules && printf 'fields date,description,amount\ninclude a.rules\n' >t.rules && hledger -f csv:t.csv --rules t.rules print; s=$?; cd ..; rm -rf t2537.$$; exit $s
>2 /b\.rules:2:1:
  \|
2 \| include a\.rules
  \| \^
This included file forms a cycle/
>=1

# ** 71. A semicolon in the description would start a comment when the output
# is reparsed, truncating the description; it is replaced with ".,", with a warning. (#2413)
<
2020-01-01,"a description; with a semicolon","this is a comment",50

RULES
fields date,description,comment,amount
$  ./csvtest.sh
2020-01-01 a description., with a semicolon  ; this is a comment
    expenses:unknown                              50
    income:unknown                               -50

>2 /replaced ';' with '\.,' in 1 description/
>=0

# ** 72. Similarly, a right parenthesis in the code would end the code early
# when reparsed; it is replaced with "]", with a warning. (#2413)
<
2020-01-01,"a (paren) code","some desc",50

RULES
fields date,code,description,amount
$  ./csvtest.sh
2020-01-01 (a (paren] code) some desc
    expenses:unknown                              50
    income:unknown                               -50

>2 /replaced '\)' with '\]' in 1 code/
>=0

# ** 73. A conditional merge rule combines the next record's fields into the
# current record, converting eg a two-row currency conversion to one transaction.
<
2026-09-01,PAYMENT,coffee,-3.50,USD
2026-09-02,CONVERT,converted USD to EUR,-100.00,USD
2026-09-02,CONVERT,converted USD to EUR,90.00,EUR
2026-09-03,PAYMENT,salary,1000.00,USD
RULES
fields date, type, desc, amt, cur
description %desc
account1 assets:bank:%cur
amount1  %amt %cur
if %type CONVERT
 merge 1
 account2 assets:bank:%cur_2
 amount2  %amt_2 %cur_2
if %type PAYMENT
 account2 expenses:unknown
$  ./csvtest.sh
2026-09-01 coffee
    assets:bank:USD                               -3.50 USD
    expenses:unknown

2026-09-02 converted USD to EUR
    assets:bank:USD                             -100.00 USD
    assets:bank:EUR                               90.00 EUR

2026-09-03 salary
    assets:bank:USD                             1000.00 USD
    expenses:unknown

>=0

# ** 74. merge N combines the next N records, eg a three-row trade.
<
2026-09-02,TRADE,bought AAPL,-1000.00,USD
2026-09-02,TRADE,bought AAPL,4,AAPL
2026-09-02,TRADE,trade fee,1.00,USD
RULES
fields date, type, desc, amt, cur
description %desc
account1 assets:broker:cash
amount1 %amt %cur
if %type TRADE
 merge 2
 account2 assets:broker:%cur_2
 amount2 %amt_2 %cur_2
 account3 expenses:fees
 amount3 %amt_3 %cur_3
 account4 assets:broker:cash
 amount4 -%amt_3 %cur_3
$  ./csvtest.sh
2026-09-02 bought AAPL
    assets:broker:cash                         -1000.00 USD
    assets:broker:AAPL                             4 AAPL
    expenses:fees                                  1.00 USD
    assets:broker:cash                            -1.00 USD

>=0

# ** 75. A top-level merge assignment pairs up all records, for CSV files
# where every transaction is two rows. Fields can also be referenced by
# number, with the same _ROWNUM suffix, and with no fields list needed.
<
2026-09-02,conversion,-100.00,USD
2026-09-02,conversion,90.00,EUR
2026-09-05,conversion,-50.00,USD
2026-09-05,conversion,44.00,EUR
RULES
merge 1
date %1
description %2
account1 assets:bank:%4
amount1 %3 %4
account2 assets:bank:%4_2
amount2 %3_2 %4_2
$  ./csvtest.sh
2026-09-02 conversion
    assets:bank:USD                             -100.00 USD
    assets:bank:EUR                               90.00 EUR

2026-09-05 conversion
    assets:bank:USD                              -50.00 USD
    assets:bank:EUR                               44.00 EUR

>=0

# ** 76. A merge rule wanting more records than remain in the file
# merges just the remaining ones; the record is still converted normally.
<
2026-09-02,CONVERT,conversion,-100.00,USD
RULES
fields date, type, desc, amt, cur
description %desc
account1 assets:a
amount %amt %cur
if %type CONVERT
 merge 1
$  ./csvtest.sh
2026-09-02 conversion
    assets:a                                    -100.00 USD
    expenses:unknown                             100.00 USD

>=0

# ** 77. Positions reported by print --location are the records' actual
# file lines, accounting for header lines, blank lines, and merged records.
<
date,type,desc,amt,cur
2026-09-01,PAYMENT,coffee,-3.50,USD

2026-09-02,CONVERT,conversion,-100.00,USD
2026-09-02,CONVERT,conversion,90.00,EUR
RULES
skip 1
fields date, type, desc, amt, cur
description %desc
account1 assets:bank:%cur
amount1  %amt %cur
if %type CONVERT
 merge 1
 account2 assets:bank:%cur_2
 amount2  %amt_2 %cur_2
if %type PAYMENT
 account2 expenses:unknown
$  ./csvtest.sh --locations | grep -oE 'csv:[0-9]+(-[0-9]+)?'
csv:2
csv:4-5
>=0

# ** 78. A merge value that is not a positive number is an error.
<
2026-09-02,CONVERT,conversion,-100.00,USD
RULES
fields date, type, desc, amt, cur
account1 assets:a
amount1 %amt %cur
if %type CONVERT
 merge 0
$  ./csvtest.sh
>2 /could not parse merge value as a positive number: 0/
>=1

# ** 79. An explicitly declared field name always wins over the _ROWNUM
# interpretation: here date_2 is a declared name, not a row 2 reference.
<
2026-09-01,2026-09-02,coffee,-3.50
RULES
fields date, date_2, desc, amt
description %desc on %date_2
account1 assets:a
amount %amt USD
$  ./csvtest.sh
2026-09-01 coffee on 2026-09-02
    assets:a                                      -3.50 USD
    expenses:unknown                               3.50 USD

>=0

# ** 80. A matcher referencing a later row's field in an if block containing
# a merge rule can never trigger the merge; a warning is printed.
<
2026-09-01,PAYMENT,coffee,-3.50,USD
2026-09-02,CONVERT,conversion,-100.00,USD
RULES
fields date, type, desc, amt, cur
description %desc
account1 assets:a
amount %amt %cur
if %cur_2 EUR
 merge 1
$  ./csvtest.sh
2026-09-01 coffee
    assets:a                                      -3.50 USD
    expenses:unknown                               3.50 USD

2026-09-02 conversion
    assets:a                                    -100.00 USD
    expenses:unknown                             100.00 USD

>2 /an if block containing a merge rule matches on a later row's field \(%cur_2\); this can not trigger a merge/
>=0

# ** 81. skip and end rules are applied before merge rules, so skipped
# records don't count toward a merge group: here the junk row between the
# conversion's two legs is skipped, and the legs are merged.
<
2026-09-02,CONVERT,conversion,-100.00,USD
2026-09-02,JUNK,section subtotal,,
2026-09-02,CONVERT,conversion,90.00,EUR
RULES
fields date, type, desc, amt, cur
description %desc
account1 assets:bank:%cur
amount1 %amt %cur
if %type JUNK
 skip
if %type CONVERT
 merge 1
 account2 assets:bank:%cur_2
 amount2 %amt_2 %cur_2
$  ./csvtest.sh
2026-09-02 conversion
    assets:bank:USD                             -100.00 USD
    assets:bank:EUR                               90.00 EUR

>=0

# ** 82. When a converted entry is rejected later, eg by transaction
# balancing, the error message also shows the CSV record it came from.
<
2026-09-02,buy,100.00,USD
RULES
fields date, desc, amt, cur
description %desc
account1 assets:a
amount1 %amt %cur
account2 assets:b
amount2 -90 %cur
$  ./csvtest.sh
>2 /This transaction is unbalanced.
The real postings' sum should be 0 but is 10.00 USD
  100.00 USD  \+  -90 USD  =  10.00 USD
this entry was converted from:
record: 2026-09-02,buy,100.00,USD
  %1 date  2026-09-02
  %2 desc  buy
  %3 amt   100.00
  %4 cur   USD/
>=1

# ** 83. Conversion error messages show each effective rule's source
# position, and any earlier-declared rules it has overridden.
<
2026-01-01,shop,badamt
RULES
fields date, desc, amt
account1 assets:a
account2 expenses:misc
amount %amt USD
if shop
 account2 expenses:shopping
$  ./csvtest.sh
>2 /  account2: +expenses:shopping +\(.*rules:6\)
    \(overrides: expenses:misc +\(.*rules:3\)\)/
>=1

# ** 84. Comment lines can appear within an if block, among the matchers
# or the indented rules; blank lines can appear among the indented rules
# without ending the block. A later non-indented rule does end the block.
<
2026-01-01,groceries,5
2026-01-02,fuel,7
RULES
fields date, desc, amt
description %desc
amount %amt USD
account1 assets:bank

if
; a comment between matchers
groceries
# another comment
fuel
 ; an indented comment before the rules
 account2 expenses:stuff

 comment  found:
 # a trailing indented comment

account1 assets:cash
$  ./csvtest.sh
2026-01-01 groceries  ; found:
    assets:cash                                    5 USD
    expenses:stuff                                -5 USD

2026-01-02 fuel  ; found:
    assets:cash                                    7 USD
    expenses:stuff                                -7 USD

>=0

# ** 85. A matcher on the same line as "if" can still begin with a
# comment character.
<
2026-01-01,#special,5
RULES
fields date, desc, amt
description %desc
amount %amt USD
account1 assets:bank
if #special
 account2 expenses:hash
$  ./csvtest.sh
2026-01-01 #special
    assets:bank                                    5 USD
    expenses:hash                                 -5 USD

>=0

# ** 86. Comment lines, indented or not, can appear within an if table.
<
2026-01-01,fuel,7
RULES
fields date, desc, amt
description %desc
amount %amt USD
account1 assets:bank

if|account2|comment
; a comment row
fuel|expenses:fuel|vroom
  ; an indented comment row
$  ./csvtest.sh
2026-01-01 fuel  ; vroom
    assets:bank                                    7 USD
    expenses:fuel                                 -7 USD

>=0

