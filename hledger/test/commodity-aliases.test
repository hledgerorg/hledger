# * commodity directive alias: tag

# ** 1. Amounts written in an alias are converted to the commodity it is an alias of.
#       So they combine with it in reports, and a transaction can balance across them.
<
commodity USD 1.00  ; alias: $

2024-01-01
    a   $100
    b   -100 USD

$ hledger -f- bal --no-total
          USD 100.00  a
         USD -100.00  b

# ** 2. print shows amounts as written.
$ hledger -f- print
2024-01-01
    a                                           $100
    b                                       USD -100

>=

# ** 3. print -x shows the converted amounts.
$ hledger -f- print -x
2024-01-01
    a                                        USD 100
    b                                       USD -100

>=

# ** 4. Multiple aliases can be declared on a single commodity, with one alias: tag each.
#       Symbols with spaces or special chars can be enclosed in double quotes.
<
commodity USD 1.00
    ; alias: $, alias: "US$", alias: "us dollars"

2024-01-01
    a   "us dollars" 100
    b   "US$"-50
    c

$ hledger -f- bal --no-total
          USD 100.00  a
          USD -50.00  b
          USD -50.00  c

# ** 5. Market prices written with an alias are converted too.
<
commodity USD 1.00  ; alias: $

P 2024-01-01 EUR $1.10
P 2024-01-01 $ 0.90 EUR

$ hledger -f- prices
P 2024-01-01 EUR USD 1.10
P 2024-01-01 USD 0.90 EUR

# ** 6. So valuation works across aliases.
<
commodity USD 1.00  ; alias: $

P 2024-01-01 USD 0.9 EUR

2024-06-01
    assets:cash       $100
    equity:opening

$ hledger -f- bal -X EUR --no-total
            90.0 EUR  assets:cash
           -90.0 EUR  equity:opening

# ** 7. The same alias declared on two different commodities is an error.
<
commodity USD 1.00
    ; alias: $

commodity AUD 1.00
    ; alias: $

$ hledger -f- check
>2 /Alias '\$' is declared on more than one commodity/
>=1

# ** 8. An alias can't have aliases of its own.
<
commodity USD 1.00  ; alias: $
commodity $1.00  ; alias: USDOLLAR

$ hledger -f- check
>2 /Commodity '\$' has aliases, but is also an alias of another commodity/
>=1

# ** 9. An alias can also be declared as a commodity (eg to set its display style for -X).
<
commodity USD 1.00  ; alias: $
commodity $1,000.00

2024-01-01
    a   $1000
    b   -1000 USD

$ hledger -f- bal -X '$' --no-total
           $1,000.00  a
          $-1,000.00  b

# ** 10. A self-alias is ignored.
<
commodity USD 1.00  ; alias: USD, alias: $

2024-01-01
    a   $100
    b   -100 USD

$ hledger -f- check

# ** 11. Aliases are accepted by check commodities.
<
commodity USD 1.00  ; alias: $

2024-01-01
    a   $100
    b

$ hledger -f- check commodities

# ** 12. cur: matches amounts written in an alias, as their commodity.
<
commodity USD 1.00  ; alias: $

2024-01-01
    a   $10
    b

$ hledger -f- bal cur:USD --no-total
           USD 10.00  a
          USD -10.00  b

# ** 13. But not as the alias.
$ hledger -f- bal cur:'\$' --no-total

# ** 14. Auto posting rules and periodic transaction rules are converted too.
<
commodity USD 1.00  ; alias: $

= expenses
    (fees)  $1

~ monthly from 2024-02
    expenses   $10
    assets

2024-01-01
    expenses   10 USD
    assets

$ hledger -f- bal --auto --forecast=2024-02 fees expenses --no-total
           USD 20.00  expenses
            USD 2.00  fees

# ** 15. An alias can have a quantity: the number of alias units equal to one unit
#        of the commodity. Amounts in the alias are divided by it.
<
commodity h 1.00  ; alias: 60 min

2024-01-01
    a   90 min
    b   2 h
    c

$ hledger -f- bal --no-total
              h 1.50  a
              h 2.00  b
             h -3.50  c

# ** 16. An alias can be the valuation commodity.
$ hledger -f- bal -X min --no-total
           90.00 min  a
          120.00 min  b
         -210.00 min  c

# ** 17. -V leaves amounts in the commodity.
$ hledger -f- bal -V --no-total
              h 1.50  a
              h 2.00  b
             h -3.50  c

# ** 18. Unit costs, balance assertions and market prices are converted as well.
<
commodity h 1.00  ; alias: 60 min
commodity USD 1.00  ; alias: 0.001 kilobucks

P 2024-01-01 min 0.002 kilobucks

2024-01-01
    a   90 min @ 2 USD
    b

2024-01-02
    a   0 min = 90 min

$ hledger -f- print -x
2024-01-01
    a                                            h 1.50 @ USD 120
    b                                       USD -180

2024-01-02
    a                                            h 0.00 = h 1.5

>=

# ** 19.
$ hledger -f- prices
P 2024-01-01 h USD 120

# ** 20. Valuation can chain through an alias with a quantity.
<
commodity USD 1.00  ; alias: 0.001 kilobucks

P 2024-01-01 USD 0.9 EUR

2024-06-01
    a   2 kilobucks
    b

$ hledger -f- bal -X EUR --no-total
          1800.0 EUR  a
         -1800.0 EUR  b

# ** 21. Each alias: tag must contain just one alias.
<
commodity USD 1.00  ; alias: $ US$

$ hledger -f- check
>2 /could not parse commodity alias "\$ US\$"/
>=1

# ** 22. An alias's quantity must be positive.
<
commodity USD 1.00  ; alias: 0 X

$ hledger -f- check
>2 /could not parse commodity alias "0 X"/
>=1

# ** 23. A commodity can't be its own alias with a quantity other than 1.
<
commodity USD 1.00  ; alias: 2 USD

$ hledger -f- check
>2 /"USD" can't be an alias of itself/
>=1

# ** 24. An alias can't be declared twice with different quantities.
<
commodity USD 1.00  ; alias: 2 X, alias: 3 X

$ hledger -f- check
>2 /alias "X" is declared more than once, with different quantities/
>=1

# ** 25. When an amount in an alias converts inexactly (10 min = 0.1666.. h),
# its unit cost is replaced by the exact total cost, so amounts inferred from it are exact
# and this balance assertion passes.
<
commodity h 1.00  ; alias: 60 min

2026-01-01
    work     10 min @ $1
    client

2026-01-02
    client   $0 = $-10

$ hledger -f- bal client
                $-10  client
--------------------
                $-10  

# ** 26. print -x shows the total cost.
$ hledger -f- print -x --round=hard
2026-01-01
    work                                         h 0.17 @@ $10
    client                                      $-10

2026-01-02
    client                                        $0 = $-10

>=

# ** 27. Balance assertions work with amounts in an alias with a quantity,
# even when converting them is inexact: each 10 min is 0.1666.. h, but together they are exactly 0.5 h.
<
commodity h 1.00  ; alias: 60 min

2026-01-01
    (time)   10 min

2026-01-02
    (time)   10 min

2026-01-03
    (time)   10 min  = 0.5 h

2026-01-04
    (time)    0 h  = 30 min

$ hledger -f- check

# ** 28. Also with mixed units, subaccount-inclusive assertions, and total assertions.
<
commodity h 1.00  ; alias: 60 min

2026-01-01 mixed units
    (a)   10 min
    (a)   10 min
    (a)   10 min
    (a)   0.5 h  = 60 min

2026-01-02 subaccount-inclusive
    (b:x)   10 min
    (b:y)   10 min
    (b:z)   10 min
    (b)      0 h  =* 0.5 h

2026-01-03 total assertion
    (c)   10 min
    (c)   10 min
    (c)   10 min
    (c)   0 h  == 0.5 h

$ hledger -f- check

# ** 29. A balance assignment calculates the amount exactly too.
<
commodity h 1.00  ; alias: 60 min

2026-01-01
    (a)   10 min
    (a)   10 min
    (a)   10 min

2026-01-02
    (a)         = 1 h

$ hledger -f- print -x date:2026-01-02
2026-01-02
    (a)                                          h 0.50 = h 1

>=

# ** 30. Converted amounts get the commodity's display style, including its precision
# when the alias has a quantity. So eg these accounts aren't mistaken for zero and hidden.
<
commodity h 1.00  ; alias: 60 min

2026-01-01
    (a)   10 min
    (b)   20 min
    (b)   10 min

$ hledger -f- bal
              h 0.17  a
              h 0.50  b
--------------------
              h 0.67  

# ** 31. An exactly converted amount gets more decimal places if needed, so it isn't mistaken for zero either.
# (Here it is displayed as 0, since BTC's display precision is 2, but the account is not hidden.)
<
commodity BTC 1.00  ; alias: 100000000 sat

2026-01-01
    (a)   1000 sat

$ hledger -f- bal
                   0  a
--------------------
                   0  

# ** 32. A balance assertion error shows converted amounts in the commodity's style.
<
commodity h 1.00  ; alias: 60 min

2026-01-01
    (time)   10 min

2026-01-02
    (time)   10 min

2026-01-03
    (time)   10 min  = 0.6 h

$ hledger -f- check
>2
hledger: Error: -:10:22:
   | 2026-01-03
10 |     (time)                                       h 0.17 = h 0.6
   |                                                         ^^^^^^^

Balance assertion failed in time
In commodity h at this point, excluding subaccounts, ignoring costs,
the asserted balance is:         h 0.6
but the calculated balance is:  h 0.50
(difference: h 0.10)
To troubleshoot, check this account's running balance with assertions disabled, eg:
hledger reg -E --ignore-assertions '2026-01-04'time$ cur:h -e
>=1

# ** 33. An unbalanced transaction error shows a repeating-decimal sum with 8 decimal places, not 255.
<
commodity h 1.00  ; alias: 60 min

2026-01-01
    a   10 min
    b   -0.2 h

$ hledger -f- check
>2
hledger: Error: -:3-5:
3 | 2026-01-01
  |     a                                            h 0.17
  |     b                                           h -0.2

This transaction is unbalanced.
The real postings' sum should be 0 but is h -0.03333333
  h 0.16666667  +  h -0.2  =  h -0.03333333
>=1

# ** 34. An alias without its own commodity directive is shown with its commodity's number format
#        (precision, decimal mark, digit groups), and the symbol placement it was written with.
<
commodity USD 1,000.00  ; alias: $

2024-01-01
    a   $1234.5
    b   -1234.50 USD

$ hledger -f- bal -X '$' --no-total
           $1,234.50  a
          $-1,234.50  b

# ** 35. print shows the amounts with that style, but their written precision.
$ hledger -f- print
2024-01-01
    a                                         $1,234.5
    b                                     USD -1,234.50

>=

# ** 36. A commodity declared again adds to its earlier declaration, rather than replacing it.
# A later declaration without aliases keeps the earlier aliases.
<
commodity 1000. kt  ; alias: 1e-3 Mt
commodity kt

2026-01-01
    (a)  2000 kt

$ hledger -f- bal -X Mt -N
                2 Mt  a

# ** 37. A later declaration's aliases are added to the earlier ones.
<
commodity 1000. kt  ; alias: 1e-3 Mt
commodity kt  ; alias: 10 users

2026-01-01
    (a)  2 Mt
    (b)  -20000 users

$ hledger -f- print -x
2026-01-01
    (a)                                         2000 kt
    (b)                                        -2000 kt

>=

# ** 38. A later declaration's display style replaces the earlier one.
<
commodity 1000. kt
commodity 1,000.00 kt

2026-01-01
    (a)  2000 kt

$ hledger -f- bal -N
         2,000.00 kt  a

# ** 39. Redeclaring an alias with a different quantity is an error.
<
commodity kt  ; alias: 1e-3 Mt
commodity kt  ; alias: 2e-3 Mt

$ hledger -f- check
>2 /alias "Mt" was declared earlier for "kt" with a different quantity \(0.001\), at -:1/
>=1

# ** 40. When several files are read with -f, their declarations of a commodity are combined,
# so -X can use the aliases from both, whichever file is read first.
# (The Mt amounts are shown with kt's number format, from usage.journal, which is read last.)
$ hledger -f commodity-aliases/savings.journal -f commodity-aliases/usage.journal bal -X Mt -N
                2 Mt  a
               -1 Mt  b

# ** 41. If the files declare different display styles, the last file's is used, as in a single file.
# --debug=1 shows the differing declarations.
$ hledger -f commodity-aliases/usage.journal -f commodity-aliases/savings.journal bal -N --debug=1
         2,000.00 kt  a
        -1,000.00 kt  b
>2 /commodity kt is declared with different display styles; using the last:
  .*commodity-aliases\/usage.journal:2: 1000 kt
  .*commodity-aliases\/savings.journal:2: 1,000.00 kt/

# ** 42. Valuation can use aliases declared in another file read with -f,
# eg to value amounts which that file's aliases didn't convert.
<
2026-03-01
    (c)  -1 Mt

$ hledger -f commodity-aliases/usage.journal -f - bal -N
             2000 kt  a
               -1 Mt  c

# ** 43.
$ hledger -f commodity-aliases/usage.journal -f - bal -X kt -N
             2000 kt  a
            -1000 kt  c

# ** 44. An alias is used for valuation only between commodities with no market price between them.
# Here a P price for users is used, not savings.journal's users alias.
<
P 2026-01-01 users 5 kt

2026-01-01
    (x)  1 users

$ hledger -f - -f commodity-aliases/savings.journal bal -X kt -N
        -1,000.00 kt  b
             5.00 kt  x

# ** 45. And only when market prices can't provide a conversion at all;
# so another file's alias can't shortcut a chain of market prices (here, X to Z via Y, at 6).
<
P 2026-01-01 X 2 Y
P 2026-01-01 Y 3 Z

2026-01-01
    (a)  1 X

$ hledger -f- -f commodity-aliases/x-alias.journal bal -X Z -N
                 6 Z  a

# ** 46. prices --show-aliases shows the alias rates (and with --show-reverse, their reverses).
$ hledger -f commodity-aliases/usage.journal -f commodity-aliases/savings.journal prices --show-aliases --show-reverse
P 0000-01-01 kt 0.001 Mt  ; commodity alias
P 0000-01-01 kt 0.1 users  ; commodity alias
P 0000-01-01 Mt 1,000.000 kt  ; commodity alias
P 0000-01-01 users 10.0 kt  ; commodity alias

# ** 47. With --locations, it shows the commodity directive which declared each alias
# (even when the commodity was declared again later).
$ hledger -f commodity-aliases/usage.journal -f commodity-aliases/savings.journal prices --show-aliases --locations
> /Mt  ; commodity alias, location: .*commodity-aliases\/usage.journal:2
.*users  ; commodity alias, location: .*commodity-aliases\/savings.journal:2/

# ** 48. Only alias rates which can be used are shown: not those between commodities with a market price between them.
<
P 2026-01-01 Z 0.2 X

$ hledger -f- -f commodity-aliases/x-alias.journal prices --show-aliases
P 2026-01-01 Z 0.2 X

# ** 49. --debug=2 shows when alias rates are tried, and where they were declared.
<
2026-01-01
    (a)  1 X

$ hledger -f- -f commodity-aliases/x-alias.journal bal -X Z -N --debug=2
                10 Z  a
>2 /no market price found from X to Z on 2026-01-01, trying commodity alias rates:
 X>Z 10  \(alias declared at .*commodity-aliases\/x-alias.journal:2\)/

# ** 50. File trees which declare an alias differently can still be combined,
# and reports which don't need the alias work as usual.
$ hledger -f commodity-aliases/usage.journal -f commodity-aliases/mt-alias.journal bal -N
             2000 kt  a

# ** 51. But converting to that alias is an error, which shows the declarations.
$ hledger -f commodity-aliases/usage.journal -f commodity-aliases/mt-alias.journal bal -N -X Mt
>2 /commodity alias Mt is declared differently by different files, so it can't be used for valuation:
.*commodity-aliases\/usage.journal:2: commodity kt  ; alias: 0.001 Mt
.*commodity-aliases\/mt-alias.journal:2: commodity kt  ; alias: 0.01 Mt/
>= 1

# ** 52. As is valuing an amount left in that alias (here, declared as an alias of two different commodities).
<
2026-03-01
    (c)  -1 Mt

$ hledger -f commodity-aliases/usage.journal -f commodity-aliases/t-alias.journal -f - bal -N -X kt
>2 /commodity alias Mt is declared differently by different files/
>= 1
