# Miscellaneous directives not tested elsewhere

# apply account, end apply account directives
<
apply account a
2016/1/1
    (b)  1
end apply account
apply account aa
2016/1/1
    (b)  1
end apply account
2016/1/2
    (c)  1

$ hledger -f - accounts
a:b
aa:b
c

# apply account's parent account may have one trailing colon, which is dropped, as in Ledger (#2858)
<
apply account a:
2016/1/1
    (b)  1
$ hledger -f - accounts
a:b

# Y, year directives
<
Y 1111
1/1
year 2222
2/2
apply year 3333
3/3
$ hledger -f- print
1111-01-01

2222-02-02

3333-03-03

>=

# apply year blocks nest, and end apply year restores the year in effect before the matching apply year,
# including one set by Y within the block.
<
Y 1111
apply year 2222
1/1
apply year 3333
Y 4444
2/2
end apply year
3/3
end apply year
4/4
$ hledger -f- print
1111-04-04

2222-01-01

2222-03-03

4444-02-02

>=

# end apply account with no matching apply account is an error.
<
end apply account
$ hledger -f- check
>2 /-:1:1:(.|
)*end apply account has no matching apply account/
>= 1

# end apply year with no matching apply year is an error.
<
Y 1111
end apply year
$ hledger -f- check
>2 /end apply year has no matching apply year/
>= 1

# Legacy ! and @ prefixes are accepted.
<
!Y 1111
1/1
@year 2222
2/2
$ hledger -f- print
1111-01-01

2222-02-02

>=

# A bare end or end apply (Ledger's shorthand for closing the innermost apply block)
# is not supported, and gives a clear error.
<
apply year 2018
end apply
$ hledger -f- check
>2 /hledger needs the kind of apply block here/
>= 1
