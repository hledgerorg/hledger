# Partial inclusive balance assignments preserve other commodities (#2093).

# = uses the correct balance scope
<
2026-01-01
    assets             7 EUR
    assets             3 USD
    assets:cash       10 EUR
    assets:cash       12 USD
    equity

2026-01-02
    assets             = 20 USD
    equity

2026-01-03
    assets        0 EUR = 7 EUR
    assets        0 USD = 20 USD
    assets        0 EUR =* 17 EUR
    assets        0 USD =* 32 USD
    assets:cash   0 EUR = 10 EUR
    assets:cash   0 USD = 12 USD
    equity        0 EUR = -17 EUR
    equity        0 USD = -32 USD

$ hledger -f- check

# == uses the correct balance scope
<
2026-01-01
    assets             7 EUR
    assets             3 USD
    assets:cash       10 EUR
    assets:cash       12 USD
    equity

2026-01-02
    assets             == 20 USD
    equity

2026-01-03
    assets        0 EUR = 0 EUR
    assets        0 USD = 20 USD
    assets        0 EUR =* 10 EUR
    assets        0 USD =* 32 USD
    assets:cash   0 EUR = 10 EUR
    assets:cash   0 USD = 12 USD
    equity        0 EUR = -10 EUR
    equity        0 USD = -32 USD

$ hledger -f- check

# =* uses the correct balance scope
<
2026-01-01
    assets             7 EUR
    assets             3 USD
    assets:cash       10 EUR
    assets:cash       12 USD
    equity

2026-01-02
    assets             =* 20 USD
    equity

2026-01-03
    assets        0 EUR = 7 EUR
    assets        0 USD = 8 USD
    assets        0 EUR =* 17 EUR
    assets        0 USD =* 20 USD
    assets:cash   0 EUR = 10 EUR
    assets:cash   0 USD = 12 USD
    equity        0 EUR = -17 EUR
    equity        0 USD = -20 USD

$ hledger -f- check

# ==* uses the correct balance scope
<
2026-01-01
    assets             7 EUR
    assets             3 USD
    assets:cash       10 EUR
    assets:cash       12 USD
    equity

2026-01-02
    assets             ==* 20 USD
    equity

2026-01-03
    assets        0 EUR = -10 EUR
    assets        0 USD = 8 USD
    assets        0 EUR =* 0 EUR
    assets        0 USD =* 20 USD
    assets:cash   0 EUR = 10 EUR
    assets:cash   0 USD = 12 USD
    equity        0 EUR = 0 EUR
    equity        0 USD = -20 USD

$ hledger -f- check

