# * assert directive
# See also hledger/test/errors/assert.test for a full error message,
# and the assertdirectivep unit tests for more parse forms and errors.

# ** 1. With no period expression, none means no posting matches the query, anywhere in the journal.
# Without change:/balance: terms, a failure lists the matching postings and suggests a reg command.
<
2026-01-01
    expenses:petty    10
    assets:cash

2026-01-02
    expenses:petty   600
    assets:cash

assert none  expenses:petty amt:>+500
$ hledger -f- check
>2 /failed \(checked over the whole journal\)\.
These postings matched:
  2026-01-02  expenses:petty  600
To see the report: hledger reg -I expenses:petty 'amt:>\+500'/
>= 1

# ** 2. The keyword-less form needs only one space, and may have a comment. some means at least one posting matches.
<
2026-01-01 opening balances
    assets:cash    10
    equity

assert some  desc:'opening balances'  ; there is an opening balances entry
assert none  assets:oldbank
$ hledger -f- check

# ** 3. some fails when nothing matches.
<
2026-01-01
    assets:cash    10
    equity

assert some  desc:'opening balances'
$ hledger -f- check
>2 /failed \(checked over the whole journal\): no postings matched/
>= 1

# ** 4. A balance: term with no period expression tests the balances at the end of the journal
# (so this passes, though checking is overdrawn for a while; see the next tests),
<
2026-01-01
    assets:checking   100
    equity

2026-02-03
    expenses:rent     110
    assets:checking

2026-02-05
    assets:checking  1000
    income:salary

assert none  type:A balance:<0
$ hledger -f- check

# ** 5. which suits rules about the present state.
<
2026-01-01
    assets:savings   12000
    equity

assert some  assets:savings balance:>=+10000
$ hledger -f- check

# ** 6. daily checks the balances at the end of every day, catching a dip which recovered.
<
2026-01-01
    assets:checking   100
    equity

2026-02-03
    expenses:rent     110
    assets:checking

2026-02-05
    assets:checking  1000
    income:salary

assert none daily  type:A balance:<0
$ hledger -f- check
>2 /failed in 2 of 36 periods: 2026-02-03, 2026-02-04\.
These balances matched:
  2026-02-03  assets:checking  -10
  2026-02-04  assets:checking  -10
To see the report: hledger bal -I -E -H -p daily -b 2026-02-03 -e 2026-02-05 type:A/
>= 1

# ** 7. monthly checks only at month ends, so it misses that dip.
<
2026-01-01
    assets:checking   100
    equity

2026-02-03
    expenses:rent     110
    assets:checking

2026-02-05
    assets:checking  1000
    income:salary

assert none monthly  type:A balance:<0
$ hledger -f- check

# ** 8. The period expression's span limits the checkpoints, not the postings: balances include the earlier postings.
<
2025-12-01
    assets:checking   -50
    equity

2026-01-15
    assets:checking    10
    equity

assert none monthly from 2026  assets balance:<0
$ hledger -f- check
>2 /failed for the period 2026-01\.
These balances matched:
  assets:checking  -40
To see the report: hledger bal -I -E -H -b 2026-01-01 -e 2026-02-01 assets 'balance:<0'/
>= 1

# ** 9. change: tests each period's change. A month with no postings has no rows:
# none passes there, some fails.
<
2026-01-05
    assets:checking  1000
    income:salary

2026-03-05
    assets:checking  1000
    income:salary

assert none monthly  income:salary change:<-2000
assert some monthly  income:salary
$ hledger -f- check
>2 /failed in 1 of 3 periods: 2026-02\.
No postings matched in that period\.
To see the report: hledger reg -I -b 2026-02-01 -e 2026-03-01 income:salary/
>= 1

# ** 10. A change span with no interval is a single period.
<
2026-01-10
    expenses:dining    300
    assets:cash

2026-06-10
    expenses:dining    300
    assets:cash

assert none in 2026  expenses:dining change:>+500
$ hledger -f- check
>2 /failed for the period 2026\.
These changes matched:
  expenses:dining  600/
>= 1

# ** 11. Rows with a zero balance exist (like bal -E).
<
2026-01-01
    assets:euro   10 EUR
    equity

2026-01-02
    assets:euro  -10 EUR
    equity

assert none daily  assets:euro
$ hledger -f- check
>2 /failed in 2 of 2 periods: 2026-01-01, 2026-01-02\./
>= 1

# ** 12. change: and balance: test each account's own amounts; depth: folds subaccounts into their parent.
<
2026-01-01
    expenses:dining:restaurant  300
    expenses:dining:cafe        300
    assets:cash

assert none monthly  expenses:dining change:>+500
$ hledger -f- check

# ** 13. With depth:2, expenses:dining's row includes its subaccounts.
<
2026-01-01
    expenses:dining:restaurant  300
    expenses:dining:cafe        300
    assets:cash

assert none monthly  expenses:dining depth:2 change:>+500
$ hledger -f- check
>2 /failed for the period 2026-01\.
These changes matched:
  expenses:dining  600/
>= 1

# ** 14. depth:REGEX=N folds just the matched accounts.
<
2026-01-01
    expenses:dining:restaurant  300
    expenses:dining:cafe        300
    expenses:travel:air         300
    expenses:travel:hotel       300
    assets:cash

assert none monthly  expenses depth:dining=2 change:>+500
$ hledger -f- check
>2 /expenses:dining  600/
>= 1

# ** 15. depth:0 folds all matched accounts into one row, comparing accounts of opposite sign:
# savings always cover the card debt.
<
2026-01-01
    assets:savings      500
    liabilities:card   -200
    equity

2026-01-10
    expenses:food       400
    liabilities:card

assert none daily  acct:'^(assets:savings|liabilities)' depth:0 balance:<0
$ hledger -f- check
>2 /failed in 1 of 10 periods: 2026-01-10\.
These balances matched:
  2026-01-10  \.\.\.  -100
To see the report: hledger bal -I -E -H -b 2026-01-10 -e 2026-01-11 'acct:\^\(assets:savings\|liabilities\)' depth:0 'balance:<0'/
>= 1

# ** 16. cur: and a commodity symbol in balance: select the amounts tested.
<
2026-01-01
    assets:wallet      -5 USD
    assets:wallet      10 EUR
    equity

assert none daily  assets balance:'<0 EUR'
assert none daily  assets cur:EUR balance:<0
assert none daily  assets cur:USD balance:<0
$ hledger -f- check
>2 /8 \| assert none daily  assets cur:USD balance:<0

This assert directive failed on 2026-01-01\.
These balances matched:
  assets:wallet  -5 USD/
>= 1

# ** 17. not: negates a change: or balance: term.
<
2026-01-01
    assets:cash     -5
    equity

assert none daily  assets not:balance:>=+0
$ hledger -f- check
>2 /assets:cash  -5/
>= 1

# ** 18. date: terms set the report period, as in bal. Here, nothing posted to a closed account.
<
2024-06-01
    assets:oldbank   10
    equity

2025-03-01
    assets:oldbank  -10
    equity

assert none  assets:oldbank date:2025-
$ hledger -f- check
>2 /assets:oldbank  -10/
>= 1

# ** 19. With balance, date: terms limit the checkpoints (as in bal -H), and earlier postings still count in the historical balances.
<
2025-12-01
    assets:cash  -50
    equity

2026-01-15
    assets:cash   10
    equity

assert none monthly  assets date:2026- balance:<0
$ hledger -f- check
>2 /failed for the period 2026-01\.
These balances matched:
  assets:cash  -40
To see the report: hledger bal -I -E -H -b 2026-01-01 -e 2026-02-01 assets date:2026- 'balance:<0'/
>= 1

# ** 20. -I disables assert directives,
<
2026-01-01
    assets:cash   -5
    equity

assert none daily  assets balance:<0
$ hledger -f- check -I

# ** 21. and --strict re-enables them,
<
2026-01-01
    assets:cash   -5
    equity

assert none daily  assets balance:<0
$ hledger -f- check -I --strict
>2 /This assert directive failed/
>= 1

# ** 22. as does check assertions.
<
2026-01-01
    assets:cash   -5
    equity

assert none daily  assets balance:<0
$ hledger -f- check -I assertions
>2 /This assert directive failed/
>= 1

# ** 23. Assert directives are checked by every command, like balance assertions.
<
2026-01-01
    assets:cash   -5
    equity

assert none daily  assets balance:<0
$ hledger -f- print
>2 /This assert directive failed/
>= 1

# ** 24. Their scope is the file tree: an assert directive in an included file sees the whole tree,
$ hledger -f directive-assert/main.j check
>2 /rules.j:1:/
>= 1

# ** 25. but not other files read with -f.
$ hledger -f directive-assert/rules.j -f directive-assert/negative.j check

# ** 26. Lot subaccounts are seen, as in bal.
<
2026-01-01 buy
    assets:broker   10 AAPL {$50}
    assets:cash    $-500

2026-02-01 sell
    assets:broker   -4 AAPL {$50} @ $60
    assets:cash    $240
    revenue:gains

assert none daily  assets:broker: cur:AAPL balance:<+10
$ hledger -f- check
>2 /failed in 1 of 32 periods: 2026-02-01\.
These balances matched:
  2026-02-01  assets:broker:\{2026-01-01, \$50\}  6 AAPL/
>= 1

# ** 27. At most 10 matching rows are listed.
<
2026-01-01
    assets:a01  -1
    assets:a02  -1
    assets:a03  -1
    assets:a04  -1
    assets:a05  -1
    assets:a06  -1
    assets:a07  -1
    assets:a08  -1
    assets:a09  -1
    assets:a10  -1
    assets:a11  -1
    assets:a12  -1
    equity

assert none daily  assets balance:<0
$ hledger -f- check
>2 /  assets:a10  -1
  \.\.\.and 2 more\.
To see them all: hledger bal -I -E -H -b 2026-01-01 -e 2026-01-02 assets 'balance:<0'/
>= 1

# ** 28. The first word must be none or some (so Ledger's assert directives are not accepted).
<
assert account("Assets:Checking").total > 0
$ hledger -f- check
>2 /assert should be followed by none or some/
>= 1

# ** 29. The period expression must be followed by two spaces.
<
assert none daily assets balance:<0
$ hledger -f- check
>2 /remainder of period expression cannot be parsed/
>= 1

# ** 30. Assert directives are reproduced by print --export.
<
assert some monthly  income:salary  ; a comment
$ hledger -f- print --export -I
assert some monthly  income:salary  ; a comment

# ** 31. With a period expression and no change:/balance: terms, some needs a matching posting in every period.
<
2025-11-15
    assets:old    10
    equity

2026-01-10
    assets:new    10
    equity

assert some monthly  assets:new
$ hledger -f- check
>2 /failed in 2 of 3 periods: 2025-11, 2025-12\.
No postings matched in those periods\./
>= 1

# ** 32. An assert rule can also be given as a check argument, quoted as one argument.
# It checks all the files read, combined.
$ hledger -f directive-assert/rules.j -f directive-assert/negative.j check 'assert none daily  assets balance:<0'
>2 /check argument:1:
1 \| assert none daily  assets balance:<0

This assert directive failed on 2026-01-01\./
>= 1

# ** 33. -I does not disable it.
<
2026-01-01
    assets:cash   -5
    equity
$ hledger -f- check -I 'assert none daily  assets balance:<0'
>2 /This assert directive failed on 2026-01-01/
>= 1

# ** 34. Several assert rules and check names can be given.
<
2026-01-01
    assets:cash    5
    equity
$ hledger -f- check ordereddates 'assert some  assets' 'assert none monthly  assets balance:<0'

# ** 35. Its syntax errors are shown like an assert directive's.
<
2026-01-01
    assets:cash    5
    equity
$ hledger -f- check 'assert none  expr:"a or change:>0"'
>2 /check argument:1:14:(.|
)*can only be combined with other query terms by AND/
>= 1

# ** 36. An unquoted assert rule gets a hint.
<
2026-01-01
    assets:cash    5
    equity
$ hledger -f- check assert none assets
>2 /To check an assert rule, quote it as one argument/
>= 1

# ** 37. An account with a matching balance is a row even if it had no postings in the period.
<
2026-01-01
    assets:cash    -5
    equity

2026-02-01
    assets:bank    10
    equity

assert none monthly from 2026-02  assets balance:<0
$ hledger -f- check
>2 /failed for the period 2026-02\.
These balances matched:
  assets:cash  -5
To see the report: hledger bal -I -E -H -b 2026-02-01 -e 2026-03-01 assets 'balance:<0'/
>= 1

# ** 38. change: and balance: can be combined; the failure shows both amounts.
<
2026-01-01
    assets:cash   100
    equity

2026-01-05
    expenses:rent  150
    assets:cash

assert none daily  assets change:<-100 balance:<0
$ hledger -f- check
>2 /failed in 1 of 5 periods: 2026-01-05\.
These accounts matched \(change, balance\):
  2026-01-05  assets:cash  -150  -50
To see the report: hledger bal -I -E -H -b 2026-01-05 -e 2026-01-06 assets 'change:<-100' 'balance:<0'/
>= 1

# ** 39. The query must follow two spaces; after one space, it is read as a period expression.
<
assert none assets balance:<0
$ hledger -f- check
>2 /could not parse this as a period expression/
>= 1

# ** 40. The query can be omitted: assert some monthly means every month has postings.
<
2026-01-01
    assets:cash   100
    equity

2026-03-01
    assets:cash   100
    equity

assert some monthly
$ hledger -f- check
>2 /failed in 1 of 3 periods: 2026-02\.
No postings matched in that period\.
To see the report: hledger reg -I -b 2026-02-01 -e 2026-03-01$/
>= 1

# ** 41. A balance in several commodities matches while any one of them does, re-tested as each changes:
# here USD dips below zero and recovers before the checked period, then EUR dips within it.
<
2026-01-01
    assets   10 USD
    equity

2026-01-01
    assets   5 EUR
    equity

2026-01-02
    assets  -15 USD
    equity

2026-01-03
    assets   10 USD
    equity

2026-01-04
    assets  -10 EUR
    equity

assert none daily from 2026-01-03  assets balance:<0
$ hledger -f- check
>2 /failed in 1 of 2 periods: 2026-01-04\.
These balances matched:
  2026-01-04  assets  -5 EUR, 5 USD
To see the report: hledger bal -I -E -H -b 2026-01-04 -e 2026-01-05 assets 'balance:<0'/
>= 1

# ** 42. A failure is reported for every failing period, with up to 5 of the periods in the first line,
# and a report command covering them all.
<
2026-01-01
    expenses:a   10
    expenses:b   10
    assets

2026-01-08
    assets      100
    equity

assert none daily  assets balance:<0
$ hledger -f- check
>2
hledger: Error: -:10:
10 | assert none daily  assets balance:<0

This assert directive failed in 7 of 8 periods: 2026-01-01, 2026-01-02, 2026-01-03, 2026-01-04, 2026-01-05 and 2 more.
These balances matched:
  2026-01-01  assets  -20
  2026-01-02  assets  -20
  2026-01-03  assets  -20
  2026-01-04  assets  -20
  2026-01-05  assets  -20
  2026-01-06  assets  -20
  2026-01-07  assets  -20
To see the report: hledger bal -I -E -H -p daily -b 2026-01-01 -e 2026-01-08 assets
>= 1

# ** 43. Up to 10 matches are shown, from all the failing periods.
<
2026-01-01
    expenses:a   10
    expenses:b   10
    assets

assert none daily from 2026-01-01 to 2026-01-09  expenses balance:>0
$ hledger -f- check
>2
hledger: Error: -:6:
6 | assert none daily from 2026-01-01 to 2026-01-09  expenses balance:>0

This assert directive failed in 8 of 8 periods: 2026-01-01, 2026-01-02, 2026-01-03, 2026-01-04, 2026-01-05 and 3 more.
These balances matched:
  2026-01-01  expenses:a  10
  2026-01-01  expenses:b  10
  2026-01-02  expenses:a  10
  2026-01-02  expenses:b  10
  2026-01-03  expenses:a  10
  2026-01-03  expenses:b  10
  2026-01-04  expenses:a  10
  2026-01-04  expenses:b  10
  2026-01-05  expenses:a  10
  2026-01-05  expenses:b  10
  ...and 6 more.
To see them all: hledger bal -I -E -H -p 'daily from 2026-01-01 to 2026-01-09' -b 2026-01-01 -e 2026-01-09 expenses
>= 1

# ** 44. skip lines skip the checks in their periods. As elsewhere, a range's end date is exclusive.
<
2026-01-01
    assets:checking   100
    equity

2026-02-03
    expenses:rent     110
    assets:checking

2026-02-05
    assets:checking  1000
    income:salary

assert none daily  type:A balance:<0
  skip 2026-02-03..2026-02-05  ; waiting for the salary
$ hledger -f- check

# ** 45. A failure's excerpt shows the skip lines, and the period count leaves out the skipped periods.
<
2026-01-01
    assets:checking   100
    equity

2026-02-03
    expenses:rent     110
    assets:checking

2026-02-05
    assets:checking  1000
    income:salary

assert none daily  type:A balance:<0
  skip 2026-02-03
$ hledger -f- check
>2 /13 \| assert none daily  type:A balance:<0
   \| skip 2026-02-03

This assert directive failed in 1 of 35 periods: 2026-02-04\./
>= 1

# ** 46. A rule with balance: and no change: terms is checked at each period's end, so only a skip covering that day skips it.
<
2026-01-01
    assets:checking   100
    equity

2026-02-10
    expenses:rent     110
    assets:checking

assert none monthly  type:A balance:<0
  skip 2026-02-15
$ hledger -f- check
>2 /failed in 1 of 2 periods: 2026-02\./
>= 1

# ** 47. A skip covering the period's last day does skip it.
<
2026-01-01
    assets:checking   100
    equity

2026-02-10
    expenses:rent     110
    assets:checking

assert none monthly  type:A balance:<0
  skip 2026-02-28
$ hledger -f- check

# ** 48. Any other rule examines the whole period, so a skip anywhere in it skips it.
<
2026-01-01
    assets:checking   100
    equity

2026-02-10
    expenses:rent     110
    assets:checking

assert none monthly  expenses change:>100
  skip 2026-02-15
$ hledger -f- check

# ** 49. skip lines can be period expressions, and can have comments, and comment lines can be among them.
<
2026-01-01
    assets:checking   100
    equity

2026-02-10
    expenses:rent     110
    assets:checking

assert none daily  type:A balance:<0  ; a rule comment
  ; a comment line
  skip from 2026-02-10 to 2026-03-01  ; a reason
$ hledger -f- check

# ** 50. skip needs a period expression with a report interval.
<
assert none  assets balance:<0
  skip 2026-02
$ hledger -f- check
>2 /skip is only allowed when the assert directive has a period expression with a report interval/
>= 1

# ** 51. A skip period can't have a report interval,
<
assert none daily  assets balance:<0
  skip monthly in 2026
$ hledger -f- check
>2 /a skip period can't have a report interval/
>= 1

# ** 52. or be unparseable.
<
assert none daily  assets balance:<0
  skip blah
$ hledger -f- check
>2 /could not parse this as a period/
>= 1

# ** 53. Other indented lines under an assert directive are errors.
<
assert none daily  assets balance:<0
  note something
$ hledger -f- check
>2 /an indented line after an assert directive should be a skip subdirective/
>= 1

# ** 54. print --export reproduces the skip lines, with their comments.
<
assert none daily  assets balance:<0  ; a rule comment
  skip 2026-02  ; a reason
$ hledger -f- print --export
assert none daily  assets balance:<0  ; a rule comment
  skip 2026-02  ; a reason

# ** 55. A rule given as a check argument can have skip lines, after a newline.
<
2026-01-01
    assets:checking   100
    equity
$ hledger -f- check "$(printf 'assert none daily  assets balance:>0\n  skip 2026-01-01')"
