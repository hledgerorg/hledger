# * The journal parser's fast path for simple transactions and price directives
# (fasttransactionp, fastmarketpricedirectivep in JournalReader.hs).
# HLEDGER_FASTPATH=check makes hledger parse every fast-path item with the general parser too,
# and fail if the results differ; so these tests verify that the two parsers agree.

# ** 1. Simple transactions and prices (which the fast path parses) mixed with less simple ones (which it declines); each fast-path result is checked against the general parser.
<
; Simple transactions and prices, which the fast path handles, mixed with ones it declines.
2024-01-01 simple
    assets:cash                 $-1.50
    expenses:food

2024/01/02 * cleared, other separators, right symbols and signs
    assets:cash                 -2 EUR
    (virtual)                   2,5 EUR
    [balanced virtual:sub]      -2,5 EUR
    [balanced virtual:other]    2,5 EUR
    expenses:other  2 EUR

2024.01.03 ! pending, unit cost, tab in an account name
    assets:stock                10 AAPL @ $1.5
    assets:cash                 $-15
    expenses:fees:a	b       1
    income:fees                 -1

2024-01-04 total cost, symbol-less amounts
    a   -1 @@ 0.5 X
    c   0.5 X
    (d)  1

2024-01-05=2024-01-06 * (code) secondary date, status, code, posting status marks
    * a  1
    ! b

Y 2024
1/7 partial date, using the Y directive's year
    a  1
    b

2024-01-08=1/9 partial secondary date, in the primary date's year
    a  1
    b

2024-01-10 plain comments  ; on the transaction
    ; and continued on the next line
    a  1  ; on a posting
    ; continued
    b  ; on a posting with no amount
    c  -1
    ; only on the line after a posting

2024-01-11 tags  ; type:sale, note : no name, k1:v1,k2: v2 ,  k3:
    ; second line tag:yes, time: 12:30
    a  1  ; date:2024-01-15 extra, date2:1/16, :leading colon, k:v
    ; cont:inued
    b  -1

2024-01-12 declined: balance assertion, digit groups, quoted symbol
    asserted  1,000.50 = 1,000.50
    b  1 "two words"
    c

P 2024-01-01 AAPL $1.5
P 2024-01-02 EUR 1,1 USD  ; comment ignored
P 2024-01-03 12:00 EUR 1.2 USD
P 2024-01-04 12:00:30+0100 EUR 1.3 USD
P 1/5 EUR 1.4 USD
P 2024-01-06 "two words" 1 X
$ HLEDGER_FASTPATH=check hledger -f- print
; Simple transactions and prices, which the fast path handles, mixed with ones it declines.
2024-01-01 simple
    assets:cash                                  $-1.50
    expenses:food

2024-01-02 * cleared, other separators, right symbols and signs
    assets:cash                                   -2 EUR
    (virtual)                                      2,5 EUR
    [balanced virtual:sub]                        -2,5 EUR
    [balanced virtual:other]                       2,5 EUR
    expenses:other                                 2 EUR

2024-01-03 ! pending, unit cost, tab in an account name
    assets:stock                                  10 AAPL @ $1.5
    assets:cash                                 $-15
    expenses:fees:a b                              1
    income:fees                                   -1

2024-01-04 total cost, symbol-less amounts
    a                                             -1 @@ 0.5 X
    c                                              0.5 X
    (d)                                            1

2024-01-05=2024-01-06 * (code) secondary date, status, code, posting status marks
    * a                                            1
    ! b

2024-01-07 partial date, using the Y directive's year
    a                                              1
    b

2024-01-08=2024-01-09 partial secondary date, in the primary date's year
    a                                              1
    b

2024-01-10 plain comments  ; on the transaction
    ; and continued on the next line
    a                                              1  ; on a posting
    ; continued
    b                                                 ; on a posting with no amount
    c                                             -1
    ; only on the line after a posting

2024-01-11 tags  ; type:sale, note : no name, k1:v1,k2: v2 ,  k3:
    ; second line tag:yes, time: 12:30
    a                                              1  ; date:2024-01-15 extra, date2:1/16, :leading colon, k:v
    ; cont:inued
    b                                             -1

2024-01-12 declined: balance assertion, digit groups, quoted symbol
    asserted                                   1,000.50          = 1,000.50
    b                                              1 "two words"
    c

>=

# ** 2. Declared commodity styles resolve ambiguous numbers the same way in both parsers.
<
; A declared style resolves ambiguous numbers, in both parsers.
commodity 1.000,00 EUR
commodity $1,000.00

2024-01-01
    a    1,000 EUR
    b    1.000 EUR
    c    $1,000
    d    $1.000
    e
$ HLEDGER_FASTPATH=check hledger -f- print
2024-01-01
    a                                              1,000 EUR
    b                                          1.000, EUR
    c                                         $1,000.
    d                                             $1.000
    e

>=

# ** 3. Alias directives, parent accounts and --alias options are applied; a default commodity directive makes symbol-less amounts decline.
<
; Alias directives, parent accounts and --alias options are applied; a default commodity makes symbol-less amounts decline.
alias checking = assets:bank:checking
apply account home

2024-01-01
    checking    1
    expenses:food

end apply account

D 1.000,00 EUR

2024-01-02
    a    1,5
    b
$ HLEDGER_FASTPATH=check hledger -f- print --alias home:expenses=home:spending
2024-01-01
    home:assets:bank:checking                      1
    home:spending:food

2024-01-02
    a                                              1,50 EUR
    b

>=

# ** 4. Register output, with market prices used for valuation (the fast path's price directives).
<
; Simple transactions and prices, which the fast path handles, mixed with ones it declines.
2024-01-01 simple
    assets:cash                 $-1.50
    expenses:food

2024/01/02 * cleared, other separators, right symbols and signs
    assets:cash                 -2 EUR
    (virtual)                   2,5 EUR
    [balanced virtual:sub]      -2,5 EUR
    [balanced virtual:other]    2,5 EUR
    expenses:other  2 EUR

2024.01.03 ! pending, unit cost, tab in an account name
    assets:stock                10 AAPL @ $1.5
    assets:cash                 $-15
    expenses:fees:a	b       1
    income:fees                 -1

2024-01-04 total cost, symbol-less amounts
    a   -1 @@ 0.5 X
    c   0.5 X
    (d)  1

2024-01-05 (code) declined: has a code
    a  1
    b

2024-01-06 declined: comment ; and tags
    a  1  ; tag: value
    b

2024-01-07 declined: balance assertion, digit groups, quoted symbol
    asserted  1,000.50 = 1,000.50
    b  1 "two words"
    c

2024-01-08=2024-01-09 declined: secondary date
    a  1
    b

P 2024-01-01 AAPL $1.5
P 2024-01-02 EUR 1,1 USD  ; comment ignored
P 2024-01-03 12:00 EUR 1.2 USD
P 2024-01-04 "two words" 1 X
$ HLEDGER_FASTPATH=check hledger -f- register -V -e 2024-01-05
2024-01-01 simple               assets:cash                 $-1.50        $-1.50
                                expenses:food                $1.50             0
2024-01-02 cleared, other se..  assets:cash               -2,4 USD      -2,4 USD
                                (virtual)                  3,0 USD       0,6 USD
                                [ba:sub]                  -3,0 USD      -2,4 USD
                                [ba:other]                 3,0 USD       0,6 USD
                                expenses:other             2,4 USD       3,0 USD
2024-01-03 pending, unit cos..  assets:stock                $15.00        $15.00
                                                                         3,0 USD
                                assets:cash                $-15.00       3,0 USD
                                expenses:fees:a b             1.00          1.00
                                                                         3,0 USD
                                income:fees                  -1.00       3,0 USD
2024-01-04 total cost, symbo..  a                            -1.00         -1.00
                                                                         3,0 USD
                                c                            0.5 X         -1.00
                                                                         3,0 USD
                                                                           0.5 X
                                (d)                           1.00       3,0 USD
                                                                           0.5 X

# ** 5. Numbers with digit group marks (including spaces), decimal marks, and leading or trailing marks; exponents decline.
<
; Numbers with digit group marks, decimal marks, and leading or trailing marks.
commodity 1.000,00 EUR

2024-01-01
    a    $1,234.56
    b    1.234,56 EUR
    c    1,000,000 X
    d    1 234,5 EUR
    e    1.000 EUR
    f    1,000. Y
    g    .5 Z
    h    1. Z
    i    1'000'000.25 CHF
    j    1_000 W
    k

2024-01-02 declined: exponents
    a    1e3 X
    b
$ HLEDGER_FASTPATH=check hledger -f- print
2024-01-01
    a                                         $1,234.56
    b                                          1.234,56 EUR
    c                                      1,000,000. X
    d                                          1.234,5 EUR
    e                                          1.000, EUR
    f                                          1,000. Y
    g                                              0.5 Z
    h                                              1 Z
    i                                      1'000'000.25 CHF
    j                                          1_000. W
    k

2024-01-02 declined: exponents
    a                                          1,000. X
    b

>=

# ** 6. With --debug=1, the parser reports how many entries took the fast path, and why it declined the others.
<
2024-01-01 simple
    a  1
    b

2024-01-02 (code) accepted  ; with a plain comment
    a  1
    b

2024-01-03 accepted  ; with a tag:val
    a  1  ; tag:val
    b

2024-01-04 declined
	c  1 = 1
    b

2024-01-05 declined
    a  1  ; [2024-01-06]
    b

P 2024-01-01 A 1 B
P 2024-01-02 "A B" 1 B
$ hledger -f- --debug=1 stats 2>&1 | grep '^fast path'
fast path was used for 60% of 5 transactions, 100% of 2 prices; declined: 1 balance assertion after a tab, 1 posting comment with bracketed date

# ** 7. Tags and posting dates in comments are parsed by the fast path; the register shows the posting dates.
<
2024-01-01 x  ; type:sale, note : no name, k1:v1,k2: v2 ,  k3:
    ; second line tag:yes, time: 12:30
    a  1  ; date:2024-01-05 extra, date2:1/6, :leading colon, k:v
    ; cont:inued
    b  -1  ; plain

2024-01-02 y  ;tight:tag,a:b
    c  1
    ; date: 2024/2/3 spaced value
    d
$ HLEDGER_FASTPATH=check hledger -f- reg
2024-01-01 x                    b                               -1            -1
2024-01-02 y                    d                               -1            -2
2024-01-05 x                    a                                1            -1
2024-02-03 y                    c                                1             0

# ** 8. The same, showing the tag values in parse order.
<
2024-01-01 x  ; type:sale, note : no name, k1:v1,k2: v2 ,  k3:
    ; second line tag:yes, time: 12:30
    a  1  ; date:2024-01-05 extra, date2:1/6, :leading colon, k:v
    ; cont:inued
    b  -1  ; plain

2024-01-02 y  ;tight:tag,a:b
    c  1
    ; date: 2024/2/3 spaced value
    d
$ HLEDGER_FASTPATH=check hledger -f- tags --values --parsed
sale
v1
v2
yes
12:30
2024-01-05 extra
1/6
v
inued
tag
b
2024/2/3 spaced value

# ** 9. Balance assertions and assignments are parsed by the fast path, in all forms and positions. Check mode compares them with the general parser's, including their source positions.
<
2024-01-01 forms
    a  1 USD = 1 USD
    a  1 USD == 2 USD
    a  1 USD =* 3 USD
    a  1 USD ==* 4 USD
    a  1 USD=5 USD
    a  1=1
    a  1 =  1
    b  -5 USD ; comment

2024-01-02 assignments  ; a comment before the postings
    ; on two lines
    c  = 10 USD
    ; continued on the next line
    d  == 20 USD  ; with a same-line comment
    e  =5 EUR
    f

2024-01-03 costs, styles, signs, other symbol forms
    g  $1,000.50 = $1,000.50 @ 2 EUR
    h  -1 X = -1 X @@ 2 EUR
    i  1 Y =+1 Y
    j  - 1 Z = - 1 Z
    (k)  1 = 1
    [l]  1 = 1
    m:n o  1 Q = 1 Q  ; tag:val
    * p  1 R = 1 R
    r

2024-01-04 non-ascii text before the assertion: the column counts characters
    счёт  1 € = 1 €
    s
$ HLEDGER_FASTPATH=check hledger -f- --debug=1 print 2>&1 | grep '^fast path'
fast path was used for 100% of 4 transactions

# ** 10. A balance assertion error shows the position calculated by the fast path, here line 5 column 11.
<
2024-01-01 x  ; comment
    ; comment
    a  1 ; comment
    ; comment
    a  1  = 3
    b
$ hledger -f- print 2>&1 | grep '^hledger: Error' | sed -E 's/.*:([0-9]+:[0-9]+):$/\1/'
5:11

# ** 11. A tab before a balance assertion is left to the general parser.
<
2024-01-01 tabs
	a  1 = 1
    b	  1 = 2
    c  -2
$ HLEDGER_FASTPATH=check hledger -f- --debug=1 print 2>&1 | grep '^fast path'
fast path was used for 0% of 1 transactions; declined: 1 balance assertion after a tab

# ** 12. So is a lot annotation in a balance assignment, which is an error.
<
2024-01-01 x
    a  = 1 X {2 Y}
$ HLEDGER_FASTPATH=check hledger -f- print 2>&1 | grep -c "unexpected '{'"
1

# ** 13. Quoted commodity symbols are parsed by the fast path, in amounts, costs, balance assertions and price directives.
<
P 2024-01-01 "A B" 1 USD
P 2024-01-01 "C" 1 "D E"
P 2024-01-01 12:00 "F1" "G 1" 2
P 2024-01-01 "" 1 USD

2024-01-01 right and left, spaced and not
    a  1 "A B"
    a  "A B" 2
    a  "A B"3
    a  1"A B"
    a  -"A B"1
    a  "A B"-1
    b

2024-01-02 costs and balance assertions
    c  1 "A B" @ 2 "C D"
    d  -1 "A B" @@ 2 "C D"
    e  1 "E1" = 1 "E1"
    f  = "F 1" 2 ; comment
    g

2024-01-03 an empty symbol, with digits and other things in symbols
    h  1 ""
    i  1 "2"
    j  "x:y" 1
    k  1 "a-b+c"
    l
$ HLEDGER_FASTPATH=check hledger -f- --debug=1 print 2>&1 | grep '^fast path'
fast path was used for 100% of 3 transactions, 100% of 4 prices

# ** 14. Quoted symbols which would be errors are left to the general parser.
<
2024-01-01 a semicolon in a quoted symbol
    a  1 "A;B"
    b
$ HLEDGER_FASTPATH=check hledger -f- print 2>&1 | grep -c '^unexpected'
1

# ** 15. So is an unclosed one.
<
P 2024-01-01 "A 1 USD
$ HLEDGER_FASTPATH=check hledger -f- print 2>&1 | grep -c '^unexpected'
1
