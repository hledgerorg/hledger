# * payees command

# ** 1. basic payees report
<
payee qux

2018/1/1 foo
  a

2018/1/2 bar | baz
  a

2018/1/3 foo
  a

$ hledger -f - payees
bar
foo
qux

# ** 2. used payees
$ hledger -f - payees --used
bar
foo

# ** 3. declared payees
$ hledger -f - payees --declared
qux

# ** 4. A date: query limits to payees used in matched transactions.
$ hledger -f - payees date:2018-01-03
foo

# ** 5. A desc: query limits to payees used in matched transactions.
$ hledger -f - payees desc:qux

# ** 6. A payee: query limits to matched payees, whether declared or used.
$ hledger -f - payees payee:qux
qux


# ** 7. --directives shows payee directives. A name containing a semicolon is double-quoted.
<
payee "Semi; colon"

2024-01-01 Foo | note
    (a)  1

$ hledger -f - payees --directives
payee Foo
payee "Semi; colon"
