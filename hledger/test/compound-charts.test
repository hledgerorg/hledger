# * --chart with the compound balance commands (incomestatement, balancesheet, cashflow..)

<
2024-01-01
    assets:bank       100
    revenues:salary

2024-01-05
    expenses:food      30
    assets:bank

2024-02-01
    assets:bank       100
    revenues:salary

2024-02-10
    expenses:rent      80
    liabilities:card

# ** 1. Each section's accounts are charted, as their contribution to the net total (so expenses are negative); at each period, a section's accounts are stacked, and the sections are side by side, with the net total as a mark.
$ hledger -f - is -M --chart -O csv
"commodity","series","role","mark","x","value"
"","revenues:salary","item","bar","Jan","100"
"","revenues:salary","item","bar","Feb","100"
"","expenses:food","item","bar","Jan","-30"
"","expenses:food","item","bar","Feb","0"
"","expenses:rent","item","bar","Jan","0"
"","expenses:rent","item","bar","Feb","-80"
"","Net","total","marker","Jan","70"
"","Net","total","marker","Feb","20"

# ** 2. In a text chart, each period has a row per section (named, and showing its contribution), and a row marking the net total.
$ hledger -f - is -M --chart -w 50
Monthly Income Statement 2024-01-01..2024-02-29

█ revenues:salary  ▓ expenses:food
▒ expenses:rent  ┃ Net

Jan  Revenues  100               │████████████████
     Expenses  -30          ▓▓▓▓▓│
     Net        70               │          ┃
Feb  Revenues  100               │████████████████
     Expenses  -80  ▒▒▒▒▒▒▒▒▒▒▒▒▒│
     Net        20               │  ┃

# ** 3. A single-period report is charted the same way, with one period.
$ hledger -f - is --chart -w 50
Income Statement 2024-01-01..2024-02-10

█ revenues:salary  ▓ expenses:food
▒ expenses:rent  ┃ Net

Revenues   200              │█████████████████████
Expenses  -110  ▒▒▒▒▒▒▒▒▒▓▓▓│
Net         90              │         ┃

# ** 4. With -1, each section has a single bar.
$ hledger -f - is -M -1 --chart -w 50
Monthly Income Statement 2024-01-01..2024-02-29

█ revenues  ▓ expenses  ┃ Net

Jan  Revenues  100               │████████████████
     Expenses  -30          ▓▓▓▓▓│
     Net        70               │          ┃
Feb  Revenues  100               │████████████████
     Expenses  -80  ▓▓▓▓▓▓▓▓▓▓▓▓▓│
     Net        20               │  ┃

# ** 5. End balances (eg balancesheet's) are stacked bars too (liabilities negative), with the net total as a line.
$ hledger -f - bs -M --chart -O csv
"commodity","series","role","mark","x","value"
"","assets:bank","item","bar","2024-01-31","70"
"","assets:bank","item","bar","2024-02-29","170"
"","liabilities:card","item","bar","2024-01-31","0"
"","liabilities:card","item","bar","2024-02-29","-80"
"","Net","total","line","2024-01-31","70"
"","Net","total","line","2024-02-29","90"

# ** 6. With one section there is no net total.
$ hledger -f - cf -M --chart -w 40
Monthly Cashflow Statement 2024-01-01..2024-02-29

Jan   70  █████████████████████
Feb  100  ██████████████████████████████

# ** 7. -N omits the net total.
$ hledger -f - is -M -N --chart -O csv
"commodity","series","role","mark","x","value"
"","revenues:salary","item","bar","Jan","100"
"","revenues:salary","item","bar","Feb","100"
"","expenses:food","item","bar","Jan","-30"
"","expenses:food","item","bar","Feb","0"
"","expenses:rent","item","bar","Jan","0"
"","expenses:rent","item","bar","Feb","-80"

# ** 8. In SVG, the sections' stacks are side by side in each period, with the net total as a line mark across them.
# The expected output is in compound-charts.svg.
$ hledger -f - is -M -O svg | diff - compound-charts.svg

<
2024-01-01
    assets:bank                  1000
    assets:equipment             3000
    liabilities:loan            -2500
    equity:opening

2024-01-31
    expenses:depreciation         100
    assets:equipment:depreciation  -100

2024-01-15
    assets:bank                   500
    revenues:sales

2024-01-20
    revenues:returns               50
    assets:bank

2024-02-15
    assets:bank                   700
    revenues:sales

# ** 9. Contra accounts, like accumulated depreciation, have the opposite sign to the rest of their section.
$ hledger -f - bs -M --chart -O csv
"commodity","series","role","mark","x","value"
"","assets:bank","item","bar","2024-01-31","1450"
"","assets:bank","item","bar","2024-02-29","2150"
"","assets:equipment","item","bar","2024-01-31","3000"
"","assets:equipment","item","bar","2024-02-29","3000"
"","assets:equipment:depreciation","item","bar","2024-01-31","-100"
"","assets:equipment:depreciation","item","bar","2024-02-29","-100"
"","liabilities:loan","item","bar","2024-01-31","-2500"
"","liabilities:loan","item","bar","2024-02-29","-2500"
"","Net","total","line","2024-01-31","1850"
"","Net","total","line","2024-02-29","2550"

<
2024-03-01
    assets:bank        1000
    revenues:salary

2024-03-05
    expenses:food       300
    assets:bank

2024-04-01
    assets:bank        1000
    revenues:salary

2024-04-05
    expenses:food       300
    assets:bank

2024-04-15
    assets:bank        2000
    expenses:taxes

# ** 10. A refund (a negative expense) increases the net total, so it is drawn above zero, in the expenses section.
$ hledger -f - is -M --chart -w 60
Monthly Income Statement 2024-03-01..2024-04-30

█ revenues:salary  ▓ expenses:food  ▒ expenses:taxes  ┃ Net

Mar  Revenues  1000      │████████████▋
     Expenses  -300  ▓▓▓▓│
     Net        700      │        ┃
Apr  Revenues  1000      │████████████▋
     Expenses  1700  ▓▓▓▓│▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒
     Net       2700      │                                 ┃

# ** 11. With depth 0, each section's single bar is labelled with the section's name.
$ hledger -f - is -M -0 --chart -O csv
"commodity","series","role","mark","x","value"
"","Revenues","item","bar","Mar","1000"
"","Revenues","item","bar","Apr","1000"
"","Expenses","item","bar","Mar","-300"
"","Expenses","item","bar","Apr","1700"
"","Net","total","marker","Mar","700"
"","Net","total","marker","Apr","2700"

# ** 12. Accounts with no type of their own (like "..." at depth 0) get their section's account type, for colouring.
$ hledger -f - is -M -0 --chart -O json | grep -o '"lbType": *"[A-Za-z]*"'
"lbType": "Revenue"
"lbType": "Expense"
