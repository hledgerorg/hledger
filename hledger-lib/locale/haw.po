msgid "match payee part of descriptions"
msgstr "kūlike me ka ʻāpana mea i uku ʻia o nā wehewehe"

#: hledger-web/templates/default-layout.hamlet
msgid "match note part of descriptions"
msgstr "kūlike me ka ʻāpana manaʻo o nā wehewehe"

#: hledger-web/templates/default-layout.hamlet
msgid "match unsigned magnitudes, or with signed N, signed amounts. For single-commodity amounts only."
msgstr "kūlike me nā nui me ka hōʻailona ʻole, a i ʻole me ka N me ka hōʻailona, nā nui me ka hōʻailona. No nā nui ma hoʻokahi ana wale nō."

#: hledger-web/templates/default-layout.hamlet
msgid "match currencies/commodities. Must match the whole symbol/name. To match dollar sign, write"
msgstr "kūlike me nā kālā/nā ana. Pono e kūlike me ka hōʻailona/ka inoa holoʻokoʻa. No ke kūlike ʻana me ka hōʻailona kālā, kākau"

#: hledger-web/templates/default-layout.hamlet
msgid "match tags, or tag and value"
msgstr "kūlike me nā lepili, a i ʻole ka lepili a me ka waiwai"

#: hledger-web/templates/default-layout.hamlet
msgid "match postings' realness/virtualness"
msgstr "kūlike me ka maoli a i ʻole ka maoli ʻole o nā laina"

#: hledger-web/templates/default-layout.hamlet
msgid "prepend not: to negate a search term"
msgstr "kau i ka not: ma mua o kahi huaʻōlelo huli e hōʻole ai"

#: hledger-web/templates/default-layout.hamlet
msgid "match with a boolean query (and, or, not, ())"
msgstr "kūlike me kahi nīnau boolean (and, or, not, ())"

#: hledger-web/templates/default-layout.hamlet
msgid "match transactions where any posting matches"
msgstr "kūlike me nā hana kālā inā kūlike kekahi laina"

#: hledger-web/templates/default-layout.hamlet
msgid "match transactions where all postings match"
msgstr "kūlike me nā hana kālā inā kūlike nā laina a pau"

#: hledger-web/templates/default-layout.hamlet
msgid "another way to set depth limit (can be per account)"
msgstr "kekahi ala ʻē aʻe e hoʻonoho ai i ka palena hohonu (hiki ke hana no kēlā me kēia moʻokālā)"

