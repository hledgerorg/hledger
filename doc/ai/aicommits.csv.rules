# Convert aicommits.csv to a journal of per-commit AI usage.
# aicommits.csv is generated by `just ai-commits-csv`; see also `just h ai-`.
# koutputtokens is estimated AI output in thousands of tokens, recorded here
# in the kt (kilotokens) commodity.
# Keep synced with tools/aicommits.

skip 1
fields commitdate,commit,author,provider,model,koutputtokens,summary,notes

date        %commitdate
description %commit | %summary
comment     %notes
account1    (ai)
amount1     %koutputtokens kt
comment1    model:%model, author:%author

# Commits whose disclosure gave no token estimate: record zero.
if %koutputtokens ^ *$
    amount1 0 kt
