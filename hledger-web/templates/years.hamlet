$if manyYears
  <p .report-links .years>
    <span>#{trc trs "years row" "Years:"}
    <a href=@?{alllink} :allCurrent:.current :allCurrent:aria-current="page" title=#{tr trs "Show all years"}>#{trc trs "years row" "All"}
    $if null byDecade
      $forall y <- years
        <a href=@?{yearlink y} :isCurrent y:.current :isCurrent y:aria-current="page" title=#{showOnly y}>#{y}
  $forall (decade, decadeYears) <- byDecade
    <p .report-links .years>
      <span>#{decade}:
      $forall y <- decadeYears
        <a href=@?{yearlink y} :isCurrent y:.current :isCurrent y:aria-current="page" title=#{showOnly y}>#{y}
