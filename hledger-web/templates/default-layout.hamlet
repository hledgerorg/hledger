
<div#spacer .col-xs-2.#{topShowsm}.#{topShowmd}>
  <h1>
    <button .visible-xs.btn.btn-default type="button" data-toggle="offcanvas">
      <span .glyphicon.glyphicon-align-left.tgl-icon>

<div#topbar .col-md-8 .col-sm-8 .col-xs-10>
  <h1>#{takeFileName (journalFilePath j)}

$if elem ViewPermission perms
  <div#sidebar-menu .sidebar-offcanvas.#{sideShowmd}.#{sideShowsm} :sidebarFold:data-fold="1" :not (T.null sidebarFoldDepth):data-depth-fold=#{sidebarFoldDepth}>
    <table .main-menu .table>
      ^{accounts}
  $# Fold the sidebar's account tree as soon as its markup is parsed, ie
  $# right here, inline (hledger.js loads at the end of the body), for the
  $# same reason as the scroll restore below: folding at DOMContentLoaded
  $# paints the tree in full first and then collapses it, a visible jump.
  $# Folding first also gives the scroll restore the folded height.
  $# In the page's tree mode (data-fold) the rows, which carry their depth
  $# and account name, get fold carets, and the folded accounts are
  $# remembered in this browser, so the sidebar stays as you left it from
  $# page to page. With a depth limit (data-depth-fold) the sidebar opens
  $# to it instead, like the report tables, and folds are not remembered.
  $# In list mode the sidebar is the same tree, shown in full, no carets.
  <script nonce=#{nonce}>
    (function () {
      var menu = document.getElementById('sidebar-menu');
      if (!menu.hasAttribute('data-fold')) { return; }
      var fold = parseInt(menu.getAttribute('data-depth-fold') || '', 10);
      var rows = [];
      menu.querySelectorAll('tr[data-depth]').forEach(function (tr) {
        rows.push({tr: tr, depth: +tr.getAttribute('data-depth'),
                   acct: tr.getAttribute('data-acct'), expanded: true, parent: false});
      });
      if (!rows.length) { return; }
      var folded = {};
      try { JSON.parse(localStorage.getItem('sidebarFolded') || '[]').forEach(function (a) { folded[a] = true; }); } catch (e) {}
      function apply() {
        var stack = [];
        rows.forEach(function (r) {
          while (stack.length > r.depth) { stack.pop(); }
          r.tr.classList.toggle('tree-fold-hide', !stack.every(function (open) { return open; }));
          r.caret.textContent = r.parent ? (r.expanded ? '▾' : '▸') : '';
          stack.push(r.expanded);
        });
      }
      function save() {
        if (!isNaN(fold)) { return; }
        try {
          localStorage.setItem('sidebarFolded', JSON.stringify(
            rows.filter(function (r) { return r.parent && !r.expanded; }).map(function (r) { return r.acct; })));
        } catch (e) {}
      }
      rows.forEach(function (r, i) {
        r.parent = i + 1 < rows.length && rows[i + 1].depth > r.depth;
        if (!isNaN(fold)) { r.expanded = r.depth < fold - 1; }
        else if (r.parent && folded[r.acct]) { r.expanded = false; }
        r.caret = document.createElement('span');
        r.caret.className = 'tree-caret';
        var name = r.tr.querySelector('.ff-wrapper a.acct-name');
        if (name) { name.parentNode.insertBefore(r.caret, name); }
        if (r.parent) {
          r.caret.addEventListener('click', function () { r.expanded = !r.expanded; apply(); save(); });
        }
      });
      apply();
    })();
  $# Restore the sidebar's scroll position (saved per-tab in sessionStorage)
  $# as soon as its markup is parsed, ie right here, inline. Waiting for eg
  $# DOMContentLoaded would be too late: on pages with a long journal/register
  $# the browser paints the sidebar (at scroll position 0) well before the
  $# rest of the document is parsed, and restoring then makes the sidebar
  $# visibly jump. sessionStorage can throw (not just be absent) when storage
  $# is blocked, eg in a sandboxed iframe, with cookies disabled, or in some
  $# private-browsing modes; the try makes this convenience a no-op there.
  <script nonce=#{nonce}>
    (function () {
      var sidebar = document.getElementById('sidebar-menu');
      var key = 'hledgerSidebarScrollTop';
      var ignoreNextScrollSave = false;
      try {
        var saved = parseInt(sessionStorage.getItem(key), 10);
        if (!isNaN(saved)) {
          sidebar.scrollTop = saved;
          // Restoring fires a scroll event, but only if the position actually
          // changed; on a page whose account list is shorter the value clamps,
          // so skip saving that one event to avoid shrinking the remembered
          // offset for later pages.
          ignoreNextScrollSave = sidebar.scrollTop !== 0;
        }
      } catch (e) {}
      sidebar.addEventListener('scroll', function () {
        if (ignoreNextScrollSave) { ignoreNextScrollSave = false; return; }
        try { sessionStorage.setItem(key, sidebar.scrollTop); } catch (e) {}
      });
    })();

<div#main-content .col-xs-12.#{mainShowmd}.#{mainShowsm}>
  $# Shown by hledger.js while the page can't reach the server.
  $if browsemode
    <div #server-stopped .alert.alert-warning role=alert hidden>
      _{HMsg "hledger-web is no longer running. It exits after fifteen minutes with no browser window showing it, or when stopped. To continue, start it again and reload this page."}
  $maybe m <- msg
    <div #message .alert.alert-info>#{m}
  $if elem ViewPermission perms
    <form#searchform.input-group method=GET>
      <input .form-control name=q value=#{qparam} placeholder=_{HMsgc "search box" "Search"}
        title=_{HMsg "Enter hledger search patterns to filter the data below"}>
      $forall (name, value) <- keptParams
        <input type=hidden name=#{name} value=#{value}>
      <div .input-group-btn>
        $if not (T.null qparam)
          <a href=@?{(here, keptParams)} .btn .btn-default title=_{HMsg "Clear search terms"}>
            <span .glyphicon .glyphicon-remove-circle>
        <button .btn .btn-default type=submit title=_{HMsg "Apply search terms"}>
          <span .glyphicon .glyphicon-search>
        $if elem EditPermission perms
          <a href="@{ManageR}" .btn.btn-default title=_{HMsg "Manage journal files"}>
            <span .glyphicon .glyphicon-wrench>
        <button .btn .btn-default type=button data-toggle="modal" data-target="#helpmodal"
           title=_{HMsg "Show search and general help"}>
          <span .glyphicon .glyphicon-question-sign>
  ^{widget}

<dialog #helpmodal tabindex=-1 aria-labelledby="helpLabel">
  <div .modal-header>
    <button type="button" .close data-dismiss="modal" aria-label=_{HMsg "Close"}>&times;
    <span .version>#{progname} #{packageversion}
    <h3 .modal-title #helpLabel>_{HMsg "Help"}
  <div .modal-body>
        $# The keys and query syntax stay outside the translatable text.
        <div .row>
          <div .col-xs-6>
            <p>
              <b>_{HMsg "Keyboard shortcuts"}
              <ul>
                <li> <code>h</code> _{HMsg "or maybe"} <code>?</code> - _{HMsg "view this help (escape or click to exit)"}
                <li> <code>j</code> - _{HMsg "go to the Journal view (home)"}
                <li> <code>a</code> - _{HMsg "add a transaction (escape to cancel)"}
                <li> <code>s</code> - _{HMsg "toggle sidebar"}
                <li> <code>f</code> - _{HMsg "focus search form"} ("find")
                <li> <code>e</code> - _{HMsg "hide empty accounts in sidebar"}
            <p>
              <b>_{HMsg "General"}
              <ul>
                <li> _{HMsg "The Journal view shows general journal entries, representing zero-sum movements of money (or other commodity) between hierarchical accounts"}
                <li> _{HMsg "The sidebar shows the resulting accounts and their final balances"}
                <li> _{HMsg "The sidebar's report links show the balance sheet, income statement, and cashflow statement, each linking to the other reports"}
                <li> _{HMsg "Parent account balances include subaccount balances"}
                <li> _{HMsg "Multiple currencies in balances are displayed one above the other"}
                <li> _{HMsg "Click account name links to see transactions affecting that account, with running balance"}
                <li> _{HMsg "Click an amount to see the transactions it is made of, in a register ending on that amount"}
                <li> _{HMsg "Click date links to see journal entries on that date"}
                <li> _{HMsg "The balance sheet and income statement show liabilities, equity, and revenues as positive amounts; their registers show them negative, as hledger does"}
          <div .col-xs-6>
            <p>
              <b>_{HMsgc "help heading" "Search"}
              <ul>
                <li> _{HMsg "Search patterns with spaces should be enclosed in quotes."}
                <li> <code>REGEX</code> - _{HMsg "match account names"}
                <li> <code>type:TYPE</code> - _{HMsg "match account types"}
                <li> <code>date:PERIODEXP</code> - _{HMsg "match dates"}
                <li> <code>status:*</code>, <code>status:!</code>, <code>status:</code> - _{HMsg "match status"}
                <li> <code>code:REGEX</code> - _{HMsg "match transaction codes"}
                <li> <code>find:REGEX</code> _{HMsg "or"} <code>::REGEX</code> - _{HMsg "match any visible field (account, amount, comment, description, code), or a date if REGEX is also a period expression"}
                <li> <code>desc:REGEX</code> - _{HMsg "match transaction descriptions"}
                <li> <code>payee:REGEX</code> - _{HMsg "match payee part of descriptions"}
                <li> <code>note:REGEX</code> - _{HMsg "match note part of descriptions"}
                <li> <code>amt:N</code>, <code>amt:&lt;N</code>, <code>amt:&gt;N</code> - _{HMsg "match unsigned magnitudes, or with signed N, signed amounts. For single-commodity amounts only."}
                <li> <code>cur:REGEX</code> - _{HMsg "match currencies/commodities. Must match the whole symbol/name. To match dollar sign, write"} <code>\$</code>
                <li> <code>tag:NAME</code>, <code>tag:NAME=REGEX</code> - _{HMsg "match tags, or tag and value"}
                <li> <code>real:BOOL</code> - _{HMsg "match postings' realness/virtualness"}
                <li> <code>not:QTERM</code> - _{HMsg "prepend not: to negate a search term"}
                <li> <code>expr:'QEXPR'</code> - _{HMsg "match with a boolean query (and, or, not, (..))"}
                <li>  <code>any:'QEXPR'</code> - _{HMsg "match transactions where any posting matches"}
                <li>  <code>all:'QEXPR'</code> - _{HMsg "match transactions where all postings match"}
                <li .gap-above> <code>depth:N</code> - _{HMsg "clip account names at this depth"}
                $# <li> Description, account, status query terms are OR'ed, others are AND'ed.
