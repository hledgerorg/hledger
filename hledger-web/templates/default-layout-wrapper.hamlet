$newline never
\<!doctype html>
<html class="no-js" lang=#{lang}>
    <head>
        <meta charset="UTF-8">

        <title>#{pageTitle pc}
        <meta name="description" content="">
        <meta name="author" content="">

        <meta name="viewport" content="width=device-width,initial-scale=1">

        ^{pageHead pc}

        <script nonce=#{nonce}>
          document.documentElement.className = document.documentElement.className.replace(/\bno-js\b/,'js');
          document.hledgerWebBaseurl = '#{base_url_ opts}'; /* save for binding keys later */
          document.hledgerWebCookieSuffix = '#{uiCookieSuffix opts}'; /* see App.uiCookie */

    <body :browsemode:data-browse-mode>
        $# Full window mode (the f key, hledger.js) is remembered in this
        $# tab's session storage, which is separate for each hledger-web
        $# (scheme, host and port), and restored here, before anything paints.
        $# So are the key hints (the . key), in local storage, which lasts.
        <script nonce=#{nonce}>
          try { if (sessionStorage.getItem('fullwindow') === '1') { document.body.classList.add('fullwindow'); } } catch (e) {}
          try { if (localStorage.getItem('keyhints') === '1') { document.body.classList.add('keyhints'); } } catch (e) {}
        <div .container-fluid>
            <div .row .row-offcanvas .row-offcanvas-left>
              ^{pageBody pc}
            <footer>
              #{extraCopyright $ appExtra $ settings master}
