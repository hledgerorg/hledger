<h2>
  _{HMsg "Upload to file"} #
  <i>#{f}
<div.alert.alert-danger>
  _{HMsg "Are you sure? This will overwrite your journal!"}
<div.form-group>
  <label .btn.btn-primary for="file">
    <input type=file id=file name=file>
    _{HMsg "Select file"}
  <span .label.label-info id="file-info">
<div.form-group>
  <input .btn.btn-default type=submit value=_{HMsg "Upload"}>
#{extra}
