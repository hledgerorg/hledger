$# A page's label spans both columns: it may be longer than an account name,
$# and nothing goes beside it.
$forall (route, label, title, gokey) <- reports
  <tr :here == route:.inacct>
    <td .top .acct colspan=2>
      <a href=@?{(route, reportParams)} :here == route:.inacct title=#{tr trs title} data-gokey=#{gokey}>
        #{tr trs label}
$forall (acct, adisplay, aindent, abal) <- items
  <tr data-indent=#{aindent} data-acct=#{acct}
     :matchesAcctSelector acct:.inacct
     :hideEmpty && not (isInterestingAccount acct):.hide>
    <td .acct :not (isInterestingAccount acct):.empty>
      <div .ff-wrapper>
        \#{indent aindent}
        <a.acct-name href="@?{acctlink acct}"
           title=#{tr trs "Show transactions affecting this account and subaccounts"}>
          #{acctLabel acct adisplay}
        $if hasSubAccounts acct
          <a href="@?{acctonlylink acct}" .only.hidden-sm.hidden-xs
             title=#{tr trs "Show transactions affecting this account but not subaccounts"}>#{tr trs "only"}
    <td .amount>
      $if mixedAmountLooksZero abal
        ^{mixedAmountAsHtmlElided trs abal}
      $else
        <a href="@?{acctlink acct}"
           title=#{tr trs "Show the transactions that make up this balance"}>
          ^{mixedAmountAsHtmlElided trs abal}
<tr .total>
  <td .total-label title=#{tottitle}>#{totlabel}
  <td .amount>
    $if mixedAmountLooksZero total
      ^{mixedAmountAsHtmlElided trs total}
    $else
      <a href="@?{totallink}" title=#{tr trs "Show the transactions that make up this total"}>
        ^{mixedAmountAsHtmlElided trs total}
