#{extra}
<h2>
  _{HMsg "Edit file"} #
  <i>#{f}
<div.alert.alert-danger>
  _{HMsg "Are you sure? This will overwrite your journal!"}
<table.table.table-condensed.edit-form>
  <tr>
    <td colspan=2>
      ^{fvInput tView}
  <tr>
    <td>
      <span.help>
        ^{helplink "data-formats" (tr trs "File format help")}
    <td .text-right>
      <a.btn.btn-default href="@{ManageR}">_{HMsg "Go back"}
      <input.btn.btn-default type=submit value=_{HMsg "Save"}>
