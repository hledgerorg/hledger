<h2>
  _{HMsg "Your journal's files"}

<div.row>
  <div .col-md-6.col-sm-8.col-xs-12>
    <table .table.table-condensed.files>
      <thead>
        <th>
          _{HMsgc "column heading" "File"}
        <th>
      <tbody>
        $forall (path, _) <- jfiles j
          <tr>
            <td .filename>
              #{path}
            <td .text-right>
              <a.btn.btn-default href=@{EditR path}>
                _{HMsg "Edit"}
              <a.btn.btn-default href=@{UploadR path}>
                _{HMsg "Upload"}
              <a.btn.btn-default href=@{DownloadR path}>
                _{HMsg "Download"}
