$# The chart's data sits on its div as JSON, and hledger.js draws it with
$# flot on page load, filling the label with the title and a legend. Keeping
$# data and code out of the page is what lets script-src be strict (#2703).
<label #register-chart-label><br>
<div #register-chart data-title=#{charttitle} data-baselink=@?{nodatelink} data-series=#{seriesjson}>
